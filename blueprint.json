{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "login": true,
  "steps": [
    {
      "step": "setSiteLanguage",
      "language": "pl_PL"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "twentytwentyfive"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "contact-form-7"
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Pedal & Co. — Serwis Rowerowy",
        "blogdescription": "Profesjonalny przegląd, naprawa i spa dla Twojego roweru",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; wp_delete_post(1, true); wp_delete_post(2, true);"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Strona główna' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='O nas' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Oferta i cennik' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Aktualności' --post_status=publish"
    },
    {
      "step": "wp-cli",
      "command": "wp post create --post_type=page --post_title='Kontakt' --post_status=publish"
    }
  ]
}
